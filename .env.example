# Скопируйте в .env и задайте значения, если нужно переопределить дефолты.
# Значения читаются в mini_llm_ui/config.py.

# --- Ollama ---
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://127.0.0.1:11434

# --- Веб-приложение ---
# Если не задано — генерируется и персистится в data/secret_key.
# SECRET_KEY=replace-me-with-64-hex-chars
